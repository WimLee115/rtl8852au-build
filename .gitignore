#
# NOTE! Don't add files that are generated in specific
# subdirectories here. Add them in the ".gitignore" file
# in that subdirectory instead.
#
# NOTE! Please use 'git ls-files -i --exclude-standard'
# command after changing this file, to see if there are
# any tracked files which get ignored after the change.
#
# Normal rules
#
.*
*.o
*.o.*
*.a
*.s
*.ko
*.so
*.so.dbg
*.mod.c
*.mod
*.i
*.lst
*.symtypes
*.order
modules.builtin
*.elf
*.bin
*.gz
*.bz2
*.lzma
*.xz
*.lzo
# .patch files at the top of the tree are temporary; tracked patches live in patches/
/*.patch
*.gcno

#
# Top-level generic files
#
/tags
/TAGS
/linux
/vmlinux
/vmlinuz
/System.map
/Module.markers
/Module.symvers

#
# Debian directory (make deb-pkg)
#
# /debian/

#
# git files that we don't want to ignore even it they are dot-files
#
!.gitignore
!.mailmap
!.github
!.github/**
# docs/.nojekyll is a dotfile (caught by the ".*" rule above) but must be
# committed so GitHub Pages serves docs/ verbatim, without Jekyll.
!docs/.nojekyll

# Firmware: uncompressed version (generated from .xz at build time)
phl/hal_g6/mac/fw_ax/rtl8852a/hal8852a_fw.c
# Firmware: compressed version (must be tracked in git)
!phl/hal_g6/mac/fw_ax/rtl8852a/hal8852a_fw.c.xz

#
# Generated include files
#
include/config
include/generated
arch/*/include/generated

# stgit generated dirs
patches-*

# quilt's series file (patches/ directory itself is tracked — see patches/README.md)
series

# cscope files
cscope.*
ncscope.*

# gnu global files
GPATH
GRTAGS
GSYMS
GTAGS

*.rej
*.porig
*.orig
*~
\#*#

#
# Leavings from module signing
#
extra_certificates
signing_key.priv
signing_key.x509
x509.genkey

# Python
__pycache__/
*.pyc

# Test artifacts
tests/test_report.json

# Local promotion drafts (personal notes, not part of the shipped project)
/docs/PROMOTION.md

